{
    "name": "@convo-lang/convo-lang-cli",
    "version": "0.9.10",
    "type": "commonjs",
    "sideEffects": false,
    "keywords": [
        "prompt",
        "prompt-engineering",
        "open-ai",
        "ai",
        "convo-lang"
    ],
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/convo-lang/convo-lang.git"
    },
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "import": "./src/index.js"
        },
        "./*.js": {
            "types": "./src/*.d.ts",
            "import": "./src/*.js"
        },
        "./*": {
            "types": "./src/*.d.ts",
            "import": "./src/*.js"
        }
    }
}