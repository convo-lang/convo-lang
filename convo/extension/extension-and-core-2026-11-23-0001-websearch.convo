<FILE_CONTENT name="convo-message-wrappers.ts" target-output-path="../../packages/convo-lang/src/lib/convo-message-wrappers.ts">
``` ts
import { deleteUndefined, safeParseNumberOrUndefined } from '@iyio/common';
import { containsConvoTag, convoRoles, convoTags, convoVars, escapeConvo, escapeConvoTagValue, getConvoTag, parseBaseConvoImport } from './convo-lib.js';
import { ConvoMessageWrapperHandler, ConvoWebSearchResult } from './convo-types.js';

/**
 * Writes calls to file import functions as `startFileImport` and `endFileImport` messages. Imports
 * queued in the `__resultImports` variable are added to the `endFileImport` message.
 */
export const convoImportMessageWrapper:ConvoMessageWrapperHandler={
    callRole:convoRoles.startFileImport,
    resultRole:convoRoles.endFileImport,
    disableVar:convoVars.__disableImportWrappers,
    toConvo:({callTags,importTags})=>`${callTags}> ${convoRoles.startFileImport}\n${importTags}> ${convoRoles.endFileImport}\n`,
    fromMessages:(call,results,fn)=>{
        const paths=results.flatMap(r=>r.tags?.filter(t=>t.name===convoTags.import && t.value).map(t=>parseBaseConvoImport(t.value??'').name)??[]);
        return {params:{[fn.params[0]?.label??'paths']:paths},returnValue:paths};
    },
};

/**
 * Writes calls to web search functions as a `searchWeb` message followed by a `searchResult`
 * message for each result. If there are no results a single empty `searchResult` message tagged
 * with `@emptySearchResult` is written.
 */
export const convoWebSearchMessageWrapper:ConvoMessageWrapperHandler={
    callRole:convoRoles.searchWeb,
    resultRole:convoRoles.searchResult,
    disableVar:convoVars.__disableWebSearchWrapper,
    toConvo:({callTags,importTags,args,returnValue})=>{
        const results=(returnValue as ConvoWebSearchResult|undefined)?.results??[];
        const out:string[]=[`${
            callTags
        }${
            getValueTag(convoTags.limit,args['limit'])
        }${
            getValueTag(convoTags.offset,args['offset'])
        }${
            args['includeLinkTarget']?`@${convoTags.includeLinkTarget}\n`:''
        }> ${convoRoles.searchWeb}\n${escapeConvo(String(args['query']??''))}`];

        if(!results.length){
            out.push(`@${convoTags.emptySearchResult}\n${importTags}> ${convoRoles.searchResult}`);
        }
        out.push(...results.map((r,i)=>`${
            r.link?`@${convoTags.sourceLink} ${escapeConvoTagValue(r.link)}\n`:''
        }${
            i===results.length-1?importTags:''
        }> ${convoRoles.searchResult}\n${escapeConvo(r.result)}`));

        return `${out.join('\n\n')}\n`;
    },
    fromMessages:(call,results)=>({
        params:deleteUndefined({
            query:call.content??'',
            limit:safeParseNumberOrUndefined(getConvoTag(call.tags,convoTags.limit)?.value),
            offset:safeParseNumberOrUndefined(getConvoTag(call.tags,convoTags.offset)?.value),
            includeLinkTarget:containsConvoTag(call.tags,convoTags.includeLinkTarget)?true:undefined,
        }),
        returnValue:{
            results:results.filter(r=>!containsConvoTag(r.tags,convoTags.emptySearchResult)).map(r=>deleteUndefined({
                link:getConvoTag(r.tags,convoTags.sourceLink)?.value,
                result:r.content??'',
            })),
        } satisfies ConvoWebSearchResult,
    }),
};

const getValueTag=(name:string,value:any):string=>(value===undefined || value===null)?'':`@${name} ${value}\n`;
```
</FILE_CONTENT>

<FILE_CONTENT name="FirecrawlConvoWebSearch.ts" target-output-path="../../packages/convo-lang/src/lib/FirecrawlConvoWebSearch.ts">
``` ts
import { defineStringParam, getErrorMessage, joinPaths } from "@iyio/common";
import { defaultConvoWebSearchLimit } from "./convo-lib.js";
import { ConvoWebSearch, ConvoWebSearchRequest, ConvoWebSearchResult } from "./convo-types.js";
import { PromiseResultType, StatusCode } from "./result-type.js";

export const firecrawlApiKeyParam=defineStringParam('firecrawlApiKey');
export const firecrawlBaseUrlParam=defineStringParam('firecrawlBaseUrl','https://api.firecrawl.dev');

export interface FirecrawlConvoWebSearchOptions
{
    /**
     * Firecrawl API key. Defaults to the `firecrawlApiKey` param
     */
    apiKey?:string;
    /**
     * Defaults to the `firecrawlBaseUrl` param
     */
    baseUrl?:string;
}

interface FirecrawlSearchRequest
{
    query:string;
    limit:number;
    scrapeOptions?:{formats:'markdown'[];onlyMainContent?:boolean};
}

interface FirecrawlSearchWebItem
{
    url:string;
    title?:string;
    description?:string;
    markdown?:string;
}

interface FirecrawlSearchResponse
{
    success:boolean;
    data?:{web?:FirecrawlSearchWebItem[]};
    warning?:string;
    error?:string;
}

/**
 * Searches the web using the Firecrawl v2 search API. Offsets are not supported by Firecrawl and
 * are ignored.
 */
export class FirecrawlConvoWebSearch implements ConvoWebSearch
{
    private readonly apiKey?:string;
    private readonly baseUrl?:string;

    public constructor({apiKey,baseUrl}:FirecrawlConvoWebSearchOptions={}){
        this.apiKey=apiKey;
        this.baseUrl=baseUrl;
    }

    public async searchAsync({
        query,
        limit=defaultConvoWebSearchLimit,
        includeLinkTarget,
    }:ConvoWebSearchRequest):PromiseResultType<ConvoWebSearchResult>{
        const apiKey=this.apiKey??firecrawlApiKeyParam.get();
        if(!apiKey){
            return {success:false,error:'Firecrawl API key not configured',statusCode:401};
        }

        const body:FirecrawlSearchRequest={query,limit};
        if(includeLinkTarget){
            body.scrapeOptions={formats:['markdown'],onlyMainContent:true};
        }

        try{
            const r=await fetch(joinPaths(this.baseUrl??firecrawlBaseUrlParam(),'/v2/search'),{
                method:'POST',
                headers:{
                    'Authorization':`Bearer ${apiKey}`,
                    'Content-Type':'application/json',
                },
                body:JSON.stringify(body),
            });
            const data=await r.json().catch(()=>undefined) as FirecrawlSearchResponse|undefined;
            if(!r.ok || !data?.success){
                return {
                    success:false,
                    error:data?.error??`Firecrawl search failed with status ${r.status}`,
                    statusCode:(r.ok?500:r.status) as StatusCode,
                };
            }
            return {
                success:true,
                result:{
                    results:(data.data?.web??[]).map(item=>({
                        link:item.url,
                        result:formatFirecrawlResult(item,includeLinkTarget),
                    })),
                },
            };
        }catch(ex){
            return {success:false,error:getErrorMessage(ex),statusCode:500};
        }
    }
}

/**
 * Returns the title and description of the item. When includeLinkTarget is true the markdown of
 * the linked page is appended in a LINK_TARGET_CONTENT tag.
 */
const formatFirecrawlResult=(item:FirecrawlSearchWebItem,includeLinkTarget?:boolean):string=>{
    const text=[item.title,item.description].filter(Boolean).join('\n\n');
    return (includeLinkTarget && item.markdown)?
        `${text}\n\n<LINK_TARGET_CONTENT>\n${item.markdown}\n</LINK_TARGET_CONTENT>`
    :
        text;
}
```
