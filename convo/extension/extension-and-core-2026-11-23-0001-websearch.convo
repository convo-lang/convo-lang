export const firecrawlBaseUrlParam=defineStringParam('firecrawlBaseUrl','https://api.firecrawl.dev');

export interface FirecrawlConvoWebSearchOptions
{
    apiKey?:string;
    baseUrl?:string;
}

interface FirecrawlSearchRequest
{
    query:string;
    limit:number;
    scrapeOptions?:{formats:'markdown'[];onlyMainContent?:boolean};
}

interface FirecrawlSearchWebItem
{
    url:string;
    title?:string;
    description?:string;
    markdown?:string;
}

interface FirecrawlSearchResponse
{
    success:boolean;
    data?:{web?:FirecrawlSearchWebItem[]};
    warning?:string;
    error?:string;
}

export class FirecrawlConvoWebSearch implements ConvoWebSearch
{
    public static fromScope(scope:Scope):FirecrawlConvoWebSearch;
    public searchAsync(request:ConvoWebSearchRequest):PromiseResultType<ConvoWebSearchResult>;
}
```

### Example of written messages

```convo
@toolId call_abc
@limit 3
\> searchWeb
typescript allman brace formatter

@sourceLink https://example.com/a
\> searchResult
Example Title

Snippet text...
```

When there are no results, the call is followed by a single empty result message:

```convo
@emptySearchResult
\> searchResult
```

